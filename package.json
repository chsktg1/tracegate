{
  "name": "tracegate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"vite --config web/vite.config.ts\"",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/setup.ts",
    "test": "vitest run",
    "test:proof": "vitest run tests/integration.test.ts --reporter=verbose",
    "test:browser": "tsx scripts/browser.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
